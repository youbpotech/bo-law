# Copie este arquivo para .env. O mesmo arquivo atende ao desenvolvimento local
# e ao Docker Compose; diferenças internas dos containers ficam em compose.yaml.

# Portas expostas pelo Docker Compose
APP_PORT=8080
PGADMIN_PORT=5050

# PostgreSQL (local e Docker)
POSTGRES_DB=bo_law
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSL=false

# Interface web do pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# API
PORT=3001
NODE_ENV=development
AUTH_SECRET=
BOOTSTRAP_ROOT_NAME=
BOOTSTRAP_ROOT_USERNAME=
BOOTSTRAP_ROOT_PASSWORD=
BOOTSTRAP_ROOT_COMPANY_ID=1

# Agente de leads e OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
LLM_TIMEOUT_MS=10000

# Processamento de audio
AUDIO_TRANSCRIPTION_ENABLED=true
AUDIO_TRANSCRIPTION_LANGUAGE=pt
AUDIO_MAX_BYTES=20971520
AUDIO_TRANSCRIPTION_TIMEOUT_MS=60000
AUDIO_MAX_ATTEMPTS=5
AUDIO_WORKER_CONCURRENCY=2
AUDIO_WORKER_POLL_MS=3000
AUDIO_WORKER_LEASE_MS=900000

# WhatsApp via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
PUBLIC_BACKEND_URL=http://localhost:8080
VALIDATE_TWILIO_SIGNATURE=true

# Empresa usada pelo webhook quando há apenas um número global configurado.
# Em ambiente multiempresa, prefira preencher o WhatsApp de cada empresa.
LEADS_DEFAULT_COMPANY_ID=
