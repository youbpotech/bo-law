# Copie este arquivo para .env. O mesmo arquivo atende ao desenvolvimento local
# e ao Docker Compose; diferenças internas dos containers ficam em compose.yaml.

# Portas expostas pelo Docker Compose
APP_PORT=8080
PGADMIN_PORT=5050
KEYCLOAK_PORT=8081

# PostgreSQL (local e Docker)
POSTGRES_DB=bo_law
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSL=false

# Interface web do pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=bo-law
KEYCLOAK_CLIENT_ID=bo-law-api
BOTNISS_API_URL=http://localhost:3000
BOTNISS_API_KEY=
BOTAIMA_API_URL=http://localhost:3000
BOTAIMA_API_KEY=
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# API
PORT=3001
NODE_ENV=development
BOOTSTRAP_ROOT_NAME=
BOOTSTRAP_ROOT_USERNAME=
BOOTSTRAP_ROOT_PASSWORD=
BOOTSTRAP_ROOT_COMPANY_ID=1

# Agente de leads e OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
LLM_TIMEOUT_MS=10000

# Processamento de audio
AUDIO_TRANSCRIPTION_ENABLED=true
AUDIO_TRANSCRIPTION_LANGUAGE=pt
AUDIO_MAX_BYTES=20971520
AUDIO_TRANSCRIPTION_TIMEOUT_MS=60000
AUDIO_MAX_ATTEMPTS=5
AUDIO_WORKER_CONCURRENCY=2
AUDIO_WORKER_POLL_MS=3000
AUDIO_WORKER_LEASE_MS=900000

# Notificações omnichannel
NOTIFICATION_WORKER_POLL_MS=3000
NOTIFICATION_MAX_ATTEMPTS=5

# Canal WhatsApp - Twilio
# Exemplo: TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Exemplo: TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
PUBLIC_BACKEND_URL=http://localhost:8080
VALIDATE_TWILIO_SIGNATURE=true

# Empresa usada pelo webhook quando há apenas um número global configurado.
# Em ambiente multiempresa, prefira preencher o WhatsApp de cada empresa.
LEADS_DEFAULT_COMPANY_ID=

# Canal Email - SMTP
# Exemplo para SMTP autenticado com STARTTLS na porta 587.
# Exemplo: SMTP_HOST=smtp.exemplo.pt
# Exemplo: SMTP_USER=utilizador-smtp
# Exemplo: SMTP_PASSWORD=senha-gerada-pelo-provedor
SMTP_PORT=587
SMTP_SECURE=false
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM="Backoffice <nao-responder@exemplo.pt>"

# Canal SMS - reservado ao futuro adapter
# O provedor ainda será definido; estes campos formam o contrato genérico inicial.
# Exemplo: SMS_PROVIDER=seu-provedor
# Exemplo: SMS_API_BASE_URL=https://api.seu-provedor.example/v1
# Exemplo: SMS_FROM=YouBPO
SMS_PROVIDER=
SMS_API_BASE_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=

# Canal interno
# Não exige credenciais externas; utiliza PostgreSQL e autenticação da aplicação.
