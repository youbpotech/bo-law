{
  "name": "bo-law",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm --recursive build",
    "build:web": "pnpm --filter @bo-law/web build",
    "build:api": "pnpm --filter @bo-law/api build",
    "test": "pnpm --recursive test",
    "type-check": "pnpm --recursive type-check",
    "lint": "eslint apps --fix",
    "lint:check": "eslint apps"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  },
  "devDependencies": {
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "~10.3.0",
    "jiti": "^2.4.2",
    "prettier": "3.6.2",
    "typescript": "~5.8.0",
    "vitest": "^3.2.4"
  }
}
